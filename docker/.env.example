# Frappe LMS Gamification - Environment Configuration
# Copy this file to .env and customize the values

# Database Configuration
DB_ROOT_PASSWORD=secure_password_123
DB_NAME=lms

# Application Ports
WEB_PORT=8000
SOCKETIO_PORT=9000

# Site Configuration
SITE_NAME=lms.localhost
ADMIN_PASSWORD=admin123

# Gamification Features
ENABLE_GAMIFICATION=1
POINTS_MULTIPLIER=1.0
STREAK_BONUS_POINTS=5
DAILY_CHALLENGE_POINTS=25
COURSE_COMPLETION_BONUS=100

# Performance Settings
WORKER_PROCESSES=2
MAX_CONNECTIONS=200
REDIS_MAXMEMORY=256mb

# Development/Production Mode
DEVELOPER_MODE=1
LOG_LEVEL=INFO

# Redis URLs (automatically configured)
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1
REDIS_SOCKETIO_URL=redis://redis:6379/2

# Optional: Custom Domain (for production)
# DOMAIN=your-domain.com
# SSL_ENABLED=1

# Optional: Email Configuration (for notifications)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# Optional: Backup Configuration
# BACKUP_ENABLED=1
# BACKUP_SCHEDULE="0 2 * * *"
# BACKUP_RETENTION_DAYS=30